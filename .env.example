# ===================================================
# Minimal Music Player - Environment Variables
# ===================================================

# ---------------------------------------------------
# Supabase Configuration
# Can be obtained from Vercel Supabase Integration or 
# Supabase Dashboard > Project Settings > API
# ---------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
# Note: Vercel Supabase integration provides NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY.
# Supabase dashboard also labels this as 'anon' public key (NEXT_PUBLIC_SUPABASE_ANON_KEY).
# Both variable names are supported.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_key_here

# ---------------------------------------------------
# Cloudflare R2 Storage (Configure when ready for R2 uploads)
# ---------------------------------------------------
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=your-r2-bucket-name
R2_PUBLIC_URL=
