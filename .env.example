# ==============================================================================
# Minimal Music Player - Environment Variables (.env.local)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Project Configuration
# ------------------------------------------------------------------------------
# Found in Supabase Dashboard > Project Settings > API:
# - Project URL: https://<project-ref>.supabase.co
# - anon / publishable key: client-safe key
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_key_here

# ------------------------------------------------------------------------------
# 2. Supabase Storage & Server-Side Admin Key (Server-Side ONLY)
# ------------------------------------------------------------------------------
# In Supabase Dashboard > Project Settings > API:
# Look for "service_role" secret key (reveal and copy).
# IMPORTANT: Keep this server-side only! Never prefix with NEXT_PUBLIC_.
# This allows the Next.js server to create signed upload URLs, calculate live
# storage usage, and delete tracks when removed from library.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Name of the public storage bucket in Supabase (defaults to "songs")
# In Supabase Dashboard > Storage > Create bucket:
# - Bucket name: songs
# - Set "Public bucket" to ENABLED (allows audio streaming without complex signed URLs)
SUPABASE_STORAGE_BUCKET=songs

# ------------------------------------------------------------------------------
# 3. Upload Security Passcode (Optional but Recommended)
# ------------------------------------------------------------------------------
# A personal passcode to prevent unauthorized visitors from uploading audio files
# to your Supabase Storage bucket. Set this to any secret word or phrase.
# When set, the web app prompts for this passcode before uploading or deleting.
UPLOAD_SECRET=choose_a_personal_passcode_here
